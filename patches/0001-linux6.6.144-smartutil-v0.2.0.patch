From 437ecf88655bf6b405eb76516228ebaa88981503 Mon Sep 17 00:00:00 2001
From: Artecxyz <artecxyz@local>
Date: Fri, 30 Oct 2026 11:24:49 +0700
Subject: [PATCH] Smartutil CPUFreq Governor v0.2.0

---
 drivers/cpufreq/Kconfig             |   27 +
 drivers/cpufreq/Makefile            |    1 +
 drivers/cpufreq/cpufreq_smartutil.c | 1711 +++++++++++++++++++++++++++
 include/linux/sched/cpufreq.h       |   11 +
 kernel/sched/cpufreq.c              |   13 +
 kernel/sched/pelt.c                 |   14 +
 6 files changed, 1777 insertions(+)
 create mode 100644 drivers/cpufreq/cpufreq_smartutil.c

diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
index a1b82168a942..3083ae539c96 100644
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -210,6 +210,33 @@ config CPU_FREQ_GOV_SCHEDUTIL
 
 	  If in doubt, say N.
 
+config CPU_FREQ_GOV_SMARTUTIL
+	bool "'smartutil' cpufreq policy governor"
+	depends on CPU_FREQ && SMP
+	select CPU_FREQ_GOV_ATTR_SET
+	select IRQ_WORK
+	help
+	  This governor is schedutil, standalone and with its own tunables,
+	  that measures the demand above a saturated CPU's capacity instead
+	  of waiting for PELT to report it.  PELT cannot show more than the
+	  capacity a CPU already has, so each CPU closes intervals of at
+	  least max(min_rate_limit_ns, 1 tick) and measures the work done
+	  over one: an interval with idle shows the demand exactly, one
+	  without any is known only to be behind.  H is the envelope of that
+	  demand, rising at once and decaying like PELT, and it is what the
+	  request uses in place of PELT.  p, the probability the CPU is behind
+	  its work, is a leaky integrator of those censored intervals, and it
+	  is what the speed floor uses.
+
+	  The request is util = max(PELT, H) capped by uclamp_max, mapped to
+	  frequency with per-tier headroom and ceilings, and floored at
+	  s*(p * lambda): the speed minimizing energy plus latency per unit
+	  of work, from the Energy Model when one is registered, else from a
+	  cube law.  lambda is the latency_weight tunable, per mille of
+	  lambda_max.
+
+	  If in doubt, say N.
+
 comment "CPU frequency scaling drivers"
 
 config CPUFREQ_DT
diff --git a/drivers/cpufreq/Makefile b/drivers/cpufreq/Makefile
