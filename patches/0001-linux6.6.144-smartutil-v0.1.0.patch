+/**
+ * cpufreq_cpu_dl_bw - deadline bandwidth of a CPU, in capacity units.
+ * @cpu: the CPU in question.
+ *
+ * cpu_bw_dl() is a static inline in kernel/sched/sched.h, so a governor that
+ * is compiled as its own object in drivers/cpufreq/ cannot call it directly.
+ * This wrapper keeps that knowledge inside the scheduler.
+ */
+unsigned long cpufreq_cpu_dl_bw(int cpu)
+{
+	return cpu_bw_dl(cpu_rq(cpu));
+}
